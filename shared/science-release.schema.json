{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Scientific Python user configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "SchemaVersion",
    "Channels",
    "ScientificPackages"
  ],
  "properties": {
    "SchemaVersion": {
      "type": "integer",
      "const": 1
    },
    "Channels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ScientificPackages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
